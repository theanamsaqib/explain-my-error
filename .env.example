# Copy to backend/.env (or to .env in this folder) and fill in your key.
# Never commit the real .env file.

# ---------------------------------------------------------------- LLM (required for "Fix My Code")
# Any OpenAI-compatible provider works.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
# Leave empty for the official OpenAI endpoint. Examples:
#   Groq         https://api.groq.com/openai/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1
#   Offline demo http://localhost:9999/v1   (see README: scripted demo LLM)
OPENAI_BASE_URL=
LLM_TIMEOUT=60

# ---------------------------------------------------------------- Agent
# How many times the agent may run code before giving up (1-5).
MAX_ATTEMPTS=3

# ---------------------------------------------------------------- Code execution sandbox
# "subprocess" (default) or "docker". Docker is safer; it falls back to subprocess if unavailable.
EXECUTION_BACKEND=subprocess
EXECUTION_TIMEOUT=5
MAX_OUTPUT_SIZE=10000
EXECUTION_MEMORY_MB=512
DOCKER_IMAGE=python:3.12-slim
MAX_CONCURRENT_EXECUTIONS=4

# ---------------------------------------------------------------- Storage
DATABASE_URL=sqlite:///./data/debug_history.db

# ---------------------------------------------------------------- Web
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------- Frontend (frontend/.env.local)
# NEXT_PUBLIC_API_URL=http://localhost:8000
